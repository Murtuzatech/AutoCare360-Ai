# Server-side secrets for the `ai` Edge Function. NEVER put these in the app's .env or any VITE_ variable.
# Set them with:  npx supabase secrets set NAME=value --project-ref <ref>
GEMINI_API_KEY=            # required
GEMINI_MODEL=              # optional, default: gemini-flash-latest
YOUTUBE_API_KEY=           # optional, enables video suggestions in chat
ALLOWED_ORIGIN=            # optional, e.g. https://your-app.vercel.app (default: *)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.
